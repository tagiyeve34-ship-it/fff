<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent"/>

    <ImageButton android:id="@+id/layers" android:src="@drawable/ic_map" android:tint="@color/purple" android:background="@drawable/bg_map_fab" android:padding="12dp" android:layout_marginStart="14dp" android:layout_marginTop="22dp" android:layout_gravity="top|start" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Xəritə görünüşü"/>

    <LinearLayout android:orientation="vertical" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:layout_marginBottom="90dp" android:layout_width="112dp" android:layout_height="wrap_content">
        <Button android:id="@+id/quickLatest" android:text="Son nöqtə" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text" android:backgroundTint="@color/surface" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/quickRoute" android:text="Marşrut" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text" android:backgroundTint="@color/surface" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/quickRefresh" android:text="Yenilə" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text" android:backgroundTint="@color/surface" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/quickHistory" android:text="Tarixçə" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text" android:backgroundTint="@color/surface" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/quickShare" android:text="Paylaş" android:textAllCaps="false" android:textSize="11sp" android:textColor="@color/text" android:backgroundTint="@color/surface" android:layout_width="match_parent" android:layout_height="48dp"/>
    </LinearLayout>

    <ImageButton android:id="@+id/target" android:src="@drawable/ic_target" android:tint="@color/purple" android:background="@drawable/bg_map_fab" android:padding="12dp" android:layout_marginStart="14dp" android:layout_marginBottom="128dp" android:layout_gravity="bottom|start" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Son nöqtəyə qayıt"/>

    <LinearLayout android:id="@+id/sheet" android:background="@drawable/bg_sheet" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="9dp" android:paddingBottom="14dp" android:elevation="18dp" android:layout_width="match_parent" android:layout_height="430dp" app:behavior_hideable="false" app:behavior_peekHeight="112dp" app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View android:background="#D5D7DE" android:layout_gravity="center_horizontal" android:layout_width="42dp" android:layout_height="4dp"/>
        <LinearLayout android:gravity="center_vertical" android:layout_marginTop="9dp" android:layout_width="match_parent" android:layout_height="54dp">
            <TextView android:id="@+id/mapAvatar" android:text="U" android:textColor="@color/purple" android:textStyle="bold" android:textSize="17sp" android:gravity="center" android:background="@drawable/bg_round_purple" android:layout_width="46dp" android:layout_height="46dp"/>
            <LinearLayout android:orientation="vertical" android:layout_marginStart="10dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><TextView android:id="@+id/mapChild" android:text="Uşaq" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="● Online" android:textColor="@color/green" android:textSize="11sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
            <TextView android:text="•••" android:textColor="@color/muted" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/mapAddress" android:text="Son GPS mövqeyi" android:textColor="@color/text" android:textSize="13sp" android:drawableStart="@drawable/ic_zone" android:drawablePadding="8dp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/mapMeta" android:text="Batareya —   •   Dəqiqlik —" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <View android:background="@color/line" android:layout_marginTop="11dp" android:layout_width="match_parent" android:layout_height="1dp"/>
        <LinearLayout android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="56dp">
            <Button android:id="@+id/refresh" android:text="Yenilə" android:textAllCaps="false" android:textSize="10sp" android:textColor="@color/purple" android:backgroundTint="@color/purpleSoft" android:layout_margin="3dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <Button android:id="@+id/route" android:text="Marşrut" android:textAllCaps="false" android:textSize="10sp" android:textColor="@color/purple" android:backgroundTint="@color/purpleSoft" android:layout_margin="3dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <Button android:id="@+id/history" android:text="Tarixçə" android:textAllCaps="false" android:textSize="10sp" android:textColor="@color/purple" android:backgroundTint="@color/purpleSoft" android:layout_margin="3dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <Button android:id="@+id/share" android:text="Paylaş" android:textAllCaps="false" android:textSize="10sp" android:textColor="@color/purple" android:backgroundTint="@color/purpleSoft" android:layout_margin="3dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView android:text="Günün xülasəsi" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text" android:layout_marginTop="11dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/mapSummary" android:text="Məlumat hesablanır..." android:textColor="@color/muted" android:textSize="13sp" android:lineSpacingExtra="7dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
