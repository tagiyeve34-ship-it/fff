<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="8dp" android:background="@color/bg">
<LinearLayout android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_width="match_parent" android:layout_height="54dp"><TextView android:text="‹" android:textSize="30sp" android:textColor="@color/text" android:layout_width="36dp" android:layout_height="wrap_content"/><TextView android:text="Zənglər" android:gravity="center" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><ImageButton android:id="@+id/dateBtn" android:src="@drawable/ic_calendar" android:tint="@color/text" android:background="@drawable/bg_soft" android:padding="10dp" android:layout_width="42dp" android:layout_height="42dp"/></LinearLayout>
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/tabs" app:singleSelection="true" app:selectionRequired="true" android:layout_marginHorizontal="16dp" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="42dp"><com.google.android.material.button.MaterialButton android:id="@+id/all" style="@style/Widget.Material3.Button.OutlinedButton" android:text="Hamısı" android:textSize="10sp"/><com.google.android.material.button.MaterialButton android:id="@+id/incoming" style="@style/Widget.Material3.Button.OutlinedButton" android:text="Gələn" android:textSize="10sp"/><com.google.android.material.button.MaterialButton android:id="@+id/outgoing" style="@style/Widget.Material3.Button.OutlinedButton" android:text="Gedən" android:textSize="10sp"/><com.google.android.material.button.MaterialButton android:id="@+id/missed" style="@style/Widget.Material3.Button.OutlinedButton" android:text="Qaçırılan" android:textSize="10sp"/></com.google.android.material.button.MaterialButtonToggleGroup>
<LinearLayout android:gravity="center_vertical" android:paddingHorizontal="18dp" android:paddingTop="12dp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/dateLabel" android:text="Bu gün" android:textStyle="bold" android:textColor="@color/text" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><TextView android:id="@+id/countLabel" android:text="0" android:textColor="@color/muted" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingBottom="18dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>